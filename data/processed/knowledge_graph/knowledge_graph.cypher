// CampusYamu admissions knowledge graph (UGC handbook 2024/2025).
// Generated by campusyamu.knowledge_graph.neo4j_export. Re-running replaces all :CampusKG nodes.
// Example queries (Neo4j Browser):
// Everything one university offers
//   MATCH (i:Institution {name:'University of Moratuwa'})<-[:AT_INSTITUTION]-(o:Offering)-[:OFFERS_COURSE]->(c:Course)
//   RETURN i, o, c
// Where a course is offered, with its A/L requirements and citations
//   MATCH (c:Course {name:'Medicine'})-[r]-(n) RETURN c, r, n
// Courses whose requirements name a subject
//   MATCH (s:Subject {name:'Accounting'})<-[:NAMES_SUBJECT]-(q:Requirement)<-[:HAS_REQUIREMENT]-(c:Course)
//   RETURN c.name, q.evidence_text
// Courses listed under a stream
//   MATCH (c:Course)-[:LISTED_UNDER_STREAM]->(s:Stream {name:'Physical Science'}) RETURN c.name ORDER BY c.name

CREATE CONSTRAINT aptitudetest_id IF NOT EXISTS FOR (n:AptitudeTest) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT artsbasket_id IF NOT EXISTS FOR (n:ArtsBasket) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT course_id IF NOT EXISTS FOR (n:Course) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT coursegroup_id IF NOT EXISTS FOR (n:CourseGroup) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT degreeprogramme_id IF NOT EXISTS FOR (n:DegreeProgramme) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT handbooksection_id IF NOT EXISTS FOR (n:HandbookSection) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT institution_id IF NOT EXISTS FOR (n:Institution) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT offering_id IF NOT EXISTS FOR (n:Offering) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT requirement_id IF NOT EXISTS FOR (n:Requirement) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT stream_id IF NOT EXISTS FOR (n:Stream) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT subject_id IF NOT EXISTS FOR (n:Subject) REQUIRE n.id IS UNIQUE;
MATCH (n:CampusKG) DETACH DELETE n;
