# Copy to .env and fill in what you use. Never commit .env.
# Tunable numbers and default models live in config/settings.yaml.

# --- OpenAI (preferences, ranking feedback, course chat, handbook extraction, career SWOT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional per-role model overrides (fall back to OPENAI_MODEL, then config/settings.yaml)
PREFERENCE_MODEL=
FEEDBACK_MODEL=
CHAT_MODEL=
HANDBOOK_EXTRACTION_MODEL=
AGENT_MODEL=
DISCOVERY_MODEL=

# --- Neo4j (knowledge-graph copy + handbook vector/BM25 search used by the course chat) ---
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Web research for career outlooks (career_trends agent) ---
# Tavily is used when its key is set; otherwise Firecrawl. Or force with SEARCH_PROVIDER=tavily|firecrawl
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
FIRECRAWL_API_KEY=
SEARCH_PROVIDER=
# Optional Reddit community signals via Apify
APIFY_API_TOKEN=
APIFY_REDDIT_ACTOR=

# --- Deployment (optional) ---
# CAMPUSYAMU_HOME=/app                 # project root holding data/ and config/ (Docker sets this)
# CAMPUSYAMU_SETTINGS=config/settings.yaml
