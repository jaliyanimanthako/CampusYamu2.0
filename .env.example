# Copy to .env and fill in what you use. Never commit .env.
# .env holds only secrets and connection settings. Models, the interests engine, search settings and
# every tunable number live in config/settings.yaml (models: preferences: career: ...).

# --- OpenAI (interests, feedback, course chat, memory, website and career research, handbook extraction) ---
OPENAI_API_KEY=
# --- Google Gemini Decision (interests when preferences.engine is gemini_decision; the course chat scope check) ---
GEMINI_API_KEY=

# --- Neo4j (knowledge-graph copy + handbook vector/BM25 search used by the course chat) ---
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Web research (career trends, university websites): Tavily when its key is set, else Firecrawl ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Optional Reddit community signals via Apify
APIFY_API_TOKEN=

# --- Public API (make api) ---
# Browser origins allowed to call the API, comma-separated (default from config/settings.yaml: *)
API_CORS_ORIGINS=

# --- Supabase (student sign-in and chat memory) ---
# Project URL. When set, every /v1 endpoint except /v1/health needs a signed-in student's token
# (Authorization: Bearer ...). When empty, the API is open and the chat has no memory: local development only.
SUPABASE_URL=
# Publishable key (sb_publishable_...): public, served to the web page by `make web` for sign-in.
SUPABASE_PUBLISHABLE_KEY=
# Only for older projects that sign tokens with the shared JWT secret (new projects use signing keys).
SUPABASE_JWT_SECRET=
# Server only, never in the page or the app: Postgres connection string (Connect -> Session pooler).
# When set, chat memory is kept there (tables: supabase/migrations/); when empty, in a local SQLite file.
SUPABASE_DB_URL=
# Optional: the API address the web page calls (default: port 8780 of the page's host)
CAMPUSYAMU_API_BASE_URL=

# --- Deployment (optional) ---
# CAMPUSYAMU_HOME=/app                 # project root holding data/ and config/ (Docker sets this)
# CAMPUSYAMU_SETTINGS=config/settings.yaml
